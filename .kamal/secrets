# Secrets Kamal injects at deploy time. These are read from your shell environment.
#
# With Doppler, pull them all in one line (uncomment), so nothing lives on disk:
#   SECRETS=$(doppler secrets download --no-file --format env-no-quotes)
#
# Otherwise export each in your shell (or a gitignored .env sourced before deploy).

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SECRET_KEY_BASE=$SECRET_KEY_BASE
DATABASE_PASSWORD=$DATABASE_PASSWORD
RESEND_API_KEY=$RESEND_API_KEY
STRIPE_SECRET_KEY=$STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=$STRIPE_WEBHOOK_SECRET
KIT_API_KEY=$KIT_API_KEY
OPENROUTER_API_KEY=$OPENROUTER_API_KEY
APIFY_API_TOKEN=$APIFY_API_TOKEN
