#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

# The integrations you can switch on by adding a key. Each is optional — the app runs without any.
INTEGRATIONS = [
  [ "Resend",     "Transactional email",  "RESEND_API_KEY",      "https://resend.com → API Keys (verify your domain first)" ],
  [ "Stripe",     "Subscription billing", "STRIPE_SECRET_KEY",   "https://dashboard.stripe.com/apikeys (use test keys while building)" ],
  [ "Kit",        "Lead capture",         "KIT_API_KEY",         "https://app.kit.com → Settings → Advanced → API" ],
  [ "OpenRouter", "Any LLM, one API",     "OPENROUTER_API_KEY",  "https://openrouter.ai/keys" ],
  [ "Apify",      "Scraping actors",      "APIFY_API_TOKEN",     "https://console.apify.com/account/integrations" ]
].freeze

def system!(*args) = system(*args, exception: true)

def ask(prompt)
  print prompt
  $stdin.gets.to_s.strip.downcase
end

def print_integration_guide
  puts "\n  Integrations (all optional — add a key to switch one on):"
  INTEGRATIONS.each do |name, what, var, where|
    puts "    • #{name.ljust(11)} #{what.ljust(22)} #{var}"
    puts "        ↳ #{where}"
  end
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  # Skip the production-only group locally (the pg gem needs libpq; you don't need it to develop).
  system! "bundle config set --local without production"
  system("bundle check") || system!("bundle install")

  puts "\n== Secrets =="
  puts "API keys are all optional — the app runs without any. They live in a local .env file"
  puts "(gitignored, loaded automatically in dev)."
  choice = ask("Create .env from the template now? [Y/n] (Enter = yes): ")

  if %w[n no].include?(choice)
    puts "Skipping — add keys later by copying .env.example to .env. See .env.example."
  elsif File.exist?(".env")
    puts "\n✓ .env already exists — leaving it untouched."
    print_integration_guide
  else
    FileUtils.cp ".env.example", ".env"
    puts "\n✓ Created .env from .env.example. Open it and fill in what you need:"
    print_integration_guide
  end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n✓ Done. Start the app with:  bin/dev"
end
