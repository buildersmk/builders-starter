# ─────────────────────────────────────────────────────────────────────────────
#  builders-starter — environment
#
#  Every integration is OPTIONAL and idle until its key is set. Copy this file to
#  `.env` and fill in what you need (or let `bin/setup` walk you through it) — the
#  app runs fine with none of it set.
#
#  Two ways to manage these:
#    • Local .env  — simplest. This file, gitignored, loaded automatically in dev.
#    • Doppler (recommended) — no secrets on disk, syncs to prod, and feeds your
#      AI agent too:  `doppler run -- bin/dev`  /  `doppler run -- claude`
#      Run `bin/setup` and choose Doppler to get started.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (local dev) ─────────────────────────────────────────────────────
# Leave blank to use your local Postgres over its Unix socket as your OS user
# (the zero-config macOS/Homebrew default). Set these to point at Docker Postgres
# or a remote database. In production these point at your Supabase pooler.
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USERNAME=
DATABASE_PASSWORD=
# DATABASE_NAME=builders_starter_development

# ── App ──────────────────────────────────────────────────────────────────────
# Your public host (used for links in emails and as the OpenRouter referer).
APP_HOST=http://localhost:3100
# APP_HOST_NAME=builders-starter.example.com   # production domain (no scheme)

# Flip to "true" to run one account per customer, resolved by subdomain.
# Default (unset/false) is single-tenant — one account, clean URLs.
MULTI_TENANT=false

# ── Resend — transactional email (SMTP) ──────────────────────────────────────
# Get a key: https://resend.com → API Keys. Verify your sending domain first.
# The SMTP username is the literal "resend"; this key is the password.
RESEND_API_KEY=
# Default "From" address (must be on your verified domain).
MAILER_SENDER=Builders Starter <onboarding@example.com>

# ── Stripe — subscription billing ────────────────────────────────────────────
# Get keys: https://dashboard.stripe.com/apikeys  (use the test keys while building).
# Then run `bin/rails stripe:setup` to create the Pro product + price, and
# `bin/rails "stripe:webhook[https://yourhost]"` to create the webhook + get its secret.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Kit (ConvertKit) — lead capture ──────────────────────────────────────────
# Get your key: https://app.kit.com → Settings → Advanced → API.
# KIT_TAG_ID is the tag applied to new leads (Grow → Tags → … → the id in the URL).
KIT_API_KEY=
KIT_TAG_ID=

# ── OpenRouter — one API for any LLM ─────────────────────────────────────────
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_APP_NAME=Builders Starter

# ── Apify — scraping actors ──────────────────────────────────────────────────
# Get a token: https://console.apify.com/account/integrations
APIFY_API_TOKEN=
