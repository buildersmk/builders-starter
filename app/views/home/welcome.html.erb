<% content_for :title, "Welcome to your starter" %>

<%
  account_ready = Account.any?
  essential_on  = StarterGuide.essential.all?(&:configured?)
  steps = [
    { done: true,          title: "Run it on your computer",
      body: "Done — you're looking at it, running live on your machine." },
    { done: account_ready, title: "Create your account",
      body: account_ready ? "Your workspace is set up and you can sign in any time." :
        "Click “Get started”, enter your email — in development the 6-digit code appears right on the page.",
      link: (account_ready ? nil : ["Get started", new_registration_path]) },
    { done: essential_on,  title: "Turn on your tools",
      body: "#{StarterGuide.configured_count} of #{StarterGuide.integrations.size} connected. Each one stays off until you add its key.",
      link: ["Set them up", guide_path(anchor: "tools")], tools: true },
    { done: false,         title: "Make it yours — with Claude",
      body: "Change the words, colours and pages by chatting with your AI agent, not by editing code.",
      link: ["Show me how", guide_path(anchor: "make-it-yours")] },
    { done: false,         title: "Go live",
      body: "When you're ready, swap in your real keys and your own domain. We'll walk you through it.",
      link: ["Launch checklist", guide_path(anchor: "go-live")] }
  ]
%>

<section class="mx-auto max-w-3xl px-5 pt-16 pb-8 text-center sm:pt-20">
  <span class="badge mb-5 reveal">Your starter · development</span>
  <h1 class="reveal text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">Welcome. Let's get you shipping.</h1>
  <p class="prose-lead reveal mx-auto mt-5 max-w-xl">
    Everything's wired and already running. Work down the checklist — and whenever you want to change
    something, just ask Claude.
  </p>
  <div class="reveal mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
    <%= link_to guide_path, class: "btn btn-primary btn-lg" do %>
      Open the Starter Guide <span aria-hidden="true">→</span>
    <% end %>
    <%= link_to "Preview your site", marketing_preview_path, class: "btn btn-outline btn-lg" %>
  </div>
</section>

<section class="mx-auto max-w-2xl px-5 pb-20">
  <div class="card reveal">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Your setup</h2>
    <ol class="mt-4 space-y-1">
      <% steps.each do |step| %>
        <li class="flex gap-4 rounded-xl p-3 transition hover:bg-slate-50">
          <% if step[:done] %>
            <span class="tick-in mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-white">
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>
            </span>
          <% else %>
            <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 border-line text-xs font-bold text-muted"><%= steps.index(step) + 1 %></span>
          <% end %>
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-ink"><%= step[:title] %></p>
            <p class="mt-0.5 text-sm text-muted"><%= step[:body] %></p>

            <% if step[:tools] %>
              <div class="mt-3 flex flex-wrap gap-2">
                <% StarterGuide.integrations.each do |tool| %>
                  <span class="inline-flex items-center gap-2 rounded-lg border border-line bg-white px-2.5 py-1.5">
                    <%= image_tag tool.logo, alt: tool.name, class: "h-4 w-4" %>
                    <span class="text-xs font-medium text-ink"><%= tool.name %></span>
                    <span class="pill <%= tool.configured? ? "pill-on" : "pill-off" %>">
                      <span class="h-1.5 w-1.5 rounded-full <%= tool.configured? ? "bg-emerald-500" : "bg-subtle" %>"></span>
                      <%= tool.configured? ? "on" : "off" %>
                    </span>
                  </span>
                <% end %>
              </div>
            <% end %>

            <% if step[:link] %>
              <%= link_to "#{step[:link][0]} →", step[:link][1], class: "mt-2 inline-block text-sm font-semibold text-brand hover:underline" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>
  </div>

  <p class="mt-6 text-center text-sm text-muted">
    This welcome screen only shows in development. Your customers see
    <%= link_to "your marketing page", marketing_preview_path, class: "font-semibold text-brand hover:underline" %>.
  </p>
</section>

<%= render "guide/behaviors" %>
