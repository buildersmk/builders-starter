<% content_for :title, "Starter Guide" %>

<%# ─────────────────────────── Hero ─────────────────────────── %>
<section class="mx-auto max-w-3xl px-5 pt-16 pb-8 text-center sm:pt-20">
  <span class="badge mb-5 reveal">Your starter kit</span>
  <h1 class="reveal text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">A real app, ready to make yours.</h1>
  <p class="prose-lead reveal mx-auto mt-5 max-w-lg">
    You don't write code. You open this project in <strong class="text-ink">Claude Code</strong> and ask —
    it builds, you look.
  </p>
</section>

<%# ─────────────────────── What's inside (icons) ─────────────────────── %>
<section class="mx-auto max-w-4xl px-5 py-8">
  <h2 class="reveal text-center text-sm font-semibold uppercase tracking-wide text-muted">What's already inside</h2>

  <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
    <%
      key_icon   = '<path d="M15.75 1.5a6.75 6.75 0 0 0-6.63 7.96L2.1 16.49A2.25 2.25 0 0 0 1.5 18v3.75c0 .41.34.75.75.75H6a.75.75 0 0 0 .75-.75v-1.5h1.5a.75.75 0 0 0 .75-.75v-1.5h1.5a.75.75 0 0 0 .53-.22l1.52-1.52a6.75 6.75 0 1 0 3.2-12.76Zm1.5 5.25a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"/>'.html_safe
      grid_icon  = '<path d="M3 3h7v7H3V3Zm0 11h7v7H3v-7ZM14 3h7v7h-7V3Zm0 11h7v7h-7v-7Z"/>'.html_safe
      phone_icon = '<path d="M8.25 2.25A2.25 2.25 0 0 0 6 4.5v15a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 19.5v-15a2.25 2.25 0 0 0-2.25-2.25h-7.5ZM12 18.75a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Z"/>'.html_safe
      builtins = [["Login that works", "6-digit code sent by email — no passwords.", key_icon],
                  ["Accounts & dashboard", "Workspaces, roles and this home screen.", grid_icon],
                  ["Installable app", "Add it to a phone's home screen; works offline.", phone_icon]]
    %>
    <% builtins.each do |title, line, icon| %>
      <div class="card lift reveal flex flex-col items-center gap-3 text-center">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-soft">
          <svg class="h-5 w-5 text-brand" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><%= icon %></svg>
        </span>
        <div>
          <p class="text-sm font-semibold text-ink"><%= title %></p>
          <p class="mt-0.5 text-xs text-muted"><%= line %></p>
        </div>
      </div>
    <% end %>

    <% StarterGuide.integrations.each do |tool| %>
      <div class="card lift reveal flex flex-col items-center gap-3 text-center">
        <span class="relative flex h-11 w-11 items-center justify-center rounded-xl border border-line bg-white">
          <%= image_tag tool.logo, alt: tool.name, class: "h-6 w-6", loading: "lazy" %>
          <% if tool.configured? %>
            <span class="absolute -right-1 -top-1 h-3 w-3 rounded-full border-2 border-white bg-emerald-500" title="Connected"></span>
          <% end %>
        </span>
        <div>
          <p class="text-sm font-semibold text-ink"><%= tool.name %></p>
          <p class="mt-0.5 text-xs text-muted"><%= tool.tagline.split(" — ").first %></p>
        </div>
      </div>
    <% end %>
  </div>

  <p class="reveal mt-5 text-center text-xs text-muted">
    The green dot means it's connected. Want to switch one on? Just ask Claude — it knows where each key goes.
  </p>
</section>

<%# ─────────────────────── How to build it (3 steps) ─────────────────────── %>
<section class="mx-auto max-w-4xl px-5 py-10">
  <h2 class="reveal text-center text-2xl font-bold text-ink">How to build it</h2>
  <p class="reveal mx-auto mt-2 max-w-md text-center text-body">Three steps. No terminal, no setup, no code.</p>

  <div class="mt-8 grid gap-5 sm:grid-cols-3">
    <%
      dl_icon   = '<path d="M12 3a.75.75 0 0 1 .75.75v9.44l3.22-3.22a.75.75 0 1 1 1.06 1.06l-4.5 4.5a.75.75 0 0 1-1.06 0l-4.5-4.5a.75.75 0 1 1 1.06-1.06l3.22 3.22V3.75A.75.75 0 0 1 12 3ZM4.5 19.5a.75.75 0 0 1 .75-.75h13.5a.75.75 0 0 1 0 1.5H5.25a.75.75 0 0 1-.75-.75Z"/>'.html_safe
      fldr_icon = '<path d="M2.25 6A2.25 2.25 0 0 1 4.5 3.75h4.19c.6 0 1.17.24 1.59.66l1.06 1.06c.14.14.33.22.53.22h5.88A2.25 2.25 0 0 1 20 7.94H4.5A2.25 2.25 0 0 0 2.25 10.2V6Zm0 5.69A2.25 2.25 0 0 1 4.5 9.44h15A2.25 2.25 0 0 1 21.75 11.7v6.05A2.25 2.25 0 0 1 19.5 20H4.5a2.25 2.25 0 0 1-2.25-2.25v-6.06Z"/>'.html_safe
      chat_icon = '<path d="M4.5 3.75A2.25 2.25 0 0 0 2.25 6v9A2.25 2.25 0 0 0 4.5 17.25h2.69l3.03 3.03a1.5 1.5 0 0 0 2.56-1.06v-1.97h4.72A2.25 2.25 0 0 0 19.75 15V6a2.25 2.25 0 0 0-2.25-2.25h-13Z"/>'.html_safe
      steps = [
        ["1", "Get the Claude Code app", "Download it once from code.claude.com and open it. Nothing else to install.", dl_icon],
        ["2", "Open this folder", "In the app: the <strong class='text-ink'>Code</strong> tab → <strong class='text-ink'>Local</strong> → <strong class='text-ink'>Select folder</strong>, and choose this project.", fldr_icon],
        ["3", "Just ask", "Type what you want in plain words. Claude makes the change; you refresh the page and look.", chat_icon]
      ]
    %>
    <% steps.each do |num, title, body, icon| %>
      <div class="card lift reveal relative overflow-hidden">
        <span class="absolute right-4 top-3 text-5xl font-extrabold text-slate-100"><%= num %></span>
        <span class="relative flex h-11 w-11 items-center justify-center rounded-xl bg-ink text-white">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><%= icon %></svg>
        </span>
        <h3 class="relative mt-4 font-bold text-ink"><%= title %></h3>
        <p class="relative mt-1 text-sm text-body"><%= body.html_safe %></p>
      </div>
    <% end %>
  </div>

  <div class="reveal mt-7 rounded-2xl border border-dashed border-line bg-canvas p-5 text-center">
    <p class="text-sm font-semibold text-ink">Not sure what to say? Describe the result you want:</p>
    <div class="mt-3 flex flex-wrap justify-center gap-2">
      <% ["“Change the homepage headline to…”", "“Make the main colour orange.”", "“Add a contact page.”", "“When someone signs up, email them.”"].each do |ask| %>
        <span class="rounded-full border border-line bg-white px-3 py-1.5 text-sm text-body"><%= ask %></span>
      <% end %>
    </div>
  </div>

  <p class="reveal mt-8 text-center text-sm">
    <%= link_to "← Back to your checklist", root_path, class: "font-semibold text-brand hover:underline" %>
  </p>
</section>

<%= render "guide/behaviors" %>
