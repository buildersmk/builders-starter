<% i = integration %>
<article id="tool-<%= i.key %>" class="card lift reveal">
  <div class="flex items-start gap-4">
    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-line bg-white">
      <%= image_tag i.logo, alt: i.name, class: "h-6 w-6", loading: "lazy" %>
    </span>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="text-lg font-bold text-ink"><%= i.name %></h3>
        <% if i.optional? %><span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-muted">optional</span><% end %>
        <span class="pill ml-auto <%= i.configured? ? "pill-on" : "pill-off" %>">
          <span class="h-1.5 w-1.5 rounded-full <%= i.configured? ? "bg-emerald-500" : "bg-subtle" %>"></span>
          <%= i.configured? ? "Connected" : "Not set yet" %>
        </span>
      </div>

      <p class="mt-1 text-sm text-body"><%= i.tagline %></p>

      <div class="mt-4 rounded-xl bg-canvas p-4">
        <p class="text-sm font-semibold text-ink">Turn it on</p>
        <ol class="mt-2 space-y-2.5 text-sm text-body">
          <li><span class="font-semibold text-ink">1.</span> Get your key from <%= link_to i.where_label, i.where_url, target: "_blank", rel: "noopener", class: "font-semibold text-brand hover:underline" %>.</li>
          <li><span class="font-semibold text-ink">2.</span> Paste it into your <code class="rounded bg-white px-1.5 py-0.5 text-xs">.env</code> next to this name:
            <button type="button" class="copy mt-1.5" data-copy="<%= i.env_var %>">
              <code data-copy-label><%= i.env_var %></code><span class="text-xs text-muted">copy</span>
            </button>
          </li>
          <li><span class="font-semibold text-ink">3.</span> Restart the app — you'll know it worked when the badge above turns <span class="font-semibold text-emerald-700">Connected</span>.</li>
        </ol>
      </div>

      <% if i.key == "stripe" || i.extra_env.any? %>
        <details class="step mt-3 rounded-xl border border-line bg-white">
          <summary class="flex items-center gap-2 px-4 py-3 text-sm font-semibold text-ink">
            <svg class="chevron h-4 w-4 text-muted" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.3 5.3a1 1 0 0 1 1.4 0l4 4a1 1 0 0 1 0 1.4l-4 4a1 1 0 1 1-1.4-1.4L10.6 10 7.3 6.7a1 1 0 0 1 0-1.4Z" clip-rule="evenodd"/></svg>
            A bit more — only when you need it
          </summary>
          <div class="space-y-3 border-t border-line px-4 py-4 text-sm text-body">
            <% if i.key == "stripe" %>
              <p><span class="font-semibold text-ink">The webhook.</span> A webhook is just Stripe tapping your app on the shoulder to say “you got paid.” One command sets it up and prints a secret to paste back into your <code class="rounded bg-canvas px-1.5 py-0.5 text-xs">.env</code>:</p>
              <button type="button" class="copy w-full" data-copy='bin/rails "stripe:webhook[https://yourdomain.com]"'>
                <code data-copy-label>bin/rails "stripe:webhook[https://yourdomain.com]"</code><span class="ml-auto text-xs text-muted">copy</span>
              </button>
              <p>And create your subscription plan in Stripe with one command:</p>
              <button type="button" class="copy w-full" data-copy="bin/rails stripe:setup">
                <code data-copy-label>bin/rails stripe:setup</code><span class="ml-auto text-xs text-muted">copy</span>
              </button>
            <% end %>
            <% i.extra_env.each do |var| %>
              <p>Optionally also set this one:
                <button type="button" class="copy mt-1" data-copy="<%= var %>">
                  <code data-copy-label><%= var %></code><span class="text-xs text-muted">copy</span>
                </button>
              </p>
            <% end %>
            <p class="text-muted">Not sure? Ask Claude: “Walk me through setting up <%= i.name %> for this app.”</p>
          </div>
        </details>
      <% end %>
    </div>
  </div>
</article>
