<% content_for :title, "Create your account" %>

<div class="card">
  <h1 class="text-xl font-bold text-ink">Create your account</h1>
  <p class="mt-1 text-sm text-muted">Passwordless — we'll email you a code to finish.</p>

  <%= form_with url: registration_path, method: :post, class: "mt-5 space-y-4" do |f| %>
    <div>
      <%= f.label :name, "Your name", class: "label" %>
      <%= f.text_field :name, value: @name, required: true, autofocus: true, class: "input" %>
    </div>
    <div>
      <%= f.label :email_address, "Email", class: "label" %>
      <%= f.email_field :email_address, value: @email, required: true, placeholder: "you@example.com", class: "input" %>
    </div>

    <% if @multi_tenant %>
      <div>
        <%= f.label :account_name, "Workspace name", class: "label" %>
        <%= f.text_field :account_name, required: true, class: "input" %>
      </div>
      <div>
        <%= f.label :subdomain, "Subdomain", class: "label" %>
        <%= f.text_field :subdomain, placeholder: "acme", class: "input" %>
      </div>
    <% end %>

    <%# Honeypot — bots fill this; humans never see it. %>
    <div class="hidden" aria-hidden="true">
      <%= f.label :company %>
      <%= f.text_field :company, tabindex: -1, autocomplete: "off" %>
    </div>

    <%= f.submit "Create account", class: "btn btn-primary w-full" %>
  <% end %>

  <p class="mt-5 text-center text-sm text-muted">
    Already have an account? <%= link_to "Sign in", new_session_path, class: "font-semibold text-brand hover:underline" %>
  </p>
</div>
