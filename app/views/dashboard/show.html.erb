<% content_for :title, "Dashboard" %>

<div class="mb-8">
  <h1 class="text-2xl font-bold text-ink">Welcome<%= ", #{Current.user.name.split.first}" if Current.user&.name.present? %>.</h1>
  <p class="mt-1 text-muted">This is your app. Build it out from here.</p>
</div>

<div class="grid gap-5 sm:grid-cols-2">
  <div class="card">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-subtle">Workspace</h2>
    <p class="mt-2 text-lg font-bold text-ink"><%= Current.account.name %></p>
    <p class="mt-1 text-sm text-muted">You're the <%= Current.user.role %>.</p>
  </div>

  <div class="card">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-subtle">Plan</h2>
    <p class="mt-2 flex items-center gap-2 text-lg font-bold text-ink">
      <%= Current.account.plan.titleize %>
      <% if Current.account.pro? %><span class="badge">Active</span><% end %>
    </p>
    <div class="mt-3">
      <% if Current.account.pro? %>
        <%= link_to "Manage billing", billing_portal_path, class: "btn btn-outline btn-sm" %>
      <% else %>
        <%= link_to "Upgrade to Pro", pricing_path, class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  </div>
</div>

<div class="card mt-5">
  <h2 class="text-lg font-bold text-ink">Next steps</h2>
  <ul class="mt-3 space-y-2 text-sm text-body">
    <li>→ Replace this dashboard with your product.</li>
    <li>→ Add your keys with <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">bin/setup</code> to switch on Stripe, Resend, Kit, OpenRouter and Apify.</li>
    <li>→ Read <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">CLAUDE.md</code> and <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">STYLE.md</code> for the house rules.</li>
  </ul>
</div>
