<% content_for :title, "Dashboard" %>
<% content_for :page_title, "Dashboard" %>

<div class="mb-7 flex items-start justify-between gap-4">
  <div>
    <h2 class="text-2xl font-bold text-ink">Welcome<%= ", #{Current.user.name.split.first}" if Current.user&.name.present? %>.</h2>
    <p class="mt-1 text-muted">This is your app. Everything from here is yours to shape.</p>
  </div>
  <button type="button" data-install-target="button" data-action="install#install" class="btn btn-outline btn-sm hidden shrink-0">
    <span aria-hidden="true">⬇</span> Install app
  </button>
</div>

<div class="grid gap-5 sm:grid-cols-2">
  <div class="card">
    <h3 class="text-sm font-semibold uppercase tracking-wide text-subtle">Workspace</h3>
    <p class="mt-2 text-lg font-bold text-ink"><%= Current.account.name %></p>
    <p class="mt-1 text-sm text-muted">You're the <%= Current.user.role %>.</p>
  </div>

  <div class="card">
    <h3 class="text-sm font-semibold uppercase tracking-wide text-subtle">Plan</h3>
    <p class="mt-2 flex items-center gap-2 text-lg font-bold text-ink">
      <%= Current.account.plan.titleize %>
      <% if Current.account.pro? %><span class="badge">Active</span><% end %>
    </p>
    <div class="mt-3">
      <% if Current.account.pro? %>
        <%= link_to "Manage billing", billing_portal_path, class: "btn btn-outline btn-sm" %>
      <% else %>
        <%= link_to "Upgrade to Pro", pricing_path, class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  </div>
</div>

<div class="card mt-5 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-soft text-xl">✦</span>
  <div class="flex-1">
    <h3 class="font-bold text-ink">Build it by asking Claude</h3>
    <p class="mt-0.5 text-sm text-muted">Open this project in Claude Code and describe what you want — a new page, a different look, a feature. No code required.</p>
  </div>
  <% if Rails.env.development? %>
    <%= link_to "How it works →", guide_path, class: "btn btn-outline btn-sm shrink-0" %>
  <% end %>
</div>
