<% content_for :title, "Dashboard" %>
<% content_for :page_title, "Dashboard" %>

<div class="mb-7">
  <h2 class="text-2xl font-bold text-ink">Welcome<%= ", #{Current.user.name.split.first}" if Current.user&.name.present? %>.</h2>
  <p class="mt-1 text-muted">This is your app. Everything from here is yours to shape.</p>
</div>

<%# Status at a glance — information, not actions (account actions live in the top-right menu). %>
<div class="grid gap-5 sm:grid-cols-2">
  <div class="card">
    <h3 class="text-sm font-semibold uppercase tracking-wide text-subtle">Workspace</h3>
    <p class="mt-2 text-lg font-bold text-ink"><%= Current.account.name %></p>
    <p class="mt-1 text-sm text-muted">You're the <%= Current.user.role %>.</p>
  </div>

  <div class="card">
    <h3 class="text-sm font-semibold uppercase tracking-wide text-subtle">Plan</h3>
    <p class="mt-2 flex items-center gap-2 text-lg font-bold text-ink">
      <%= Current.account.plan.titleize %>
      <% if Current.account.pro? %><span class="badge">Active</span><% end %>
    </p>
    <% unless Current.account.pro? %>
      <%= link_to "Upgrade to Pro →", pricing_path, class: "mt-2 inline-block text-sm font-semibold text-brand hover:underline" %>
    <% end %>
  </div>
</div>

<%# The one primary thing to do here. %>
<div class="card mt-5 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-soft text-2xl">✦</span>
  <div class="flex-1">
    <h3 class="text-lg font-bold text-ink">Build it by asking Claude</h3>
    <p class="mt-1 text-sm text-muted">Open this project in Claude Code and describe what you want — a new page, a different look, a feature. No code required.</p>
  </div>
  <% if Rails.env.development? %>
    <%= link_to "How it works", guide_path, class: "btn btn-primary shrink-0" %>
  <% end %>
</div>
