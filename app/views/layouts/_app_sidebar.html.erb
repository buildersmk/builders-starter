<%# Classic app sidebar. Add your product's sections to NAV below — that's the point.
    On mobile it slides in; the top bar's menu button toggles it (see _app_topbar + the inline script). %>
<aside id="app-sidebar"
       class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col border-r border-line bg-surface transition-transform duration-200 lg:static lg:translate-x-0">
  <div class="flex h-16 shrink-0 items-center gap-2 border-b border-line px-5">
    <%= link_to dashboard_path, class: "text-lg font-extrabold tracking-tight text-ink" do %>
      builders<span class="text-brand">.</span>starter
    <% end %>
  </div>

  <%# Product navigation. Add your app's sections here as you build them — that's the point.
      (Account, plan, billing and sign-out live in the top-right menu, not here.) %>
  <nav class="flex-1 space-y-1 overflow-y-auto p-3">
    <%
      home_svg = '<path d="M11.47 3.84a.75.75 0 0 1 1.06 0l8.69 8.69a.75.75 0 1 1-1.06 1.06l-.22-.22V19.5a1.5 1.5 0 0 1-1.5 1.5h-3a.75.75 0 0 1-.75-.75V15a.75.75 0 0 0-.75-.75h-1.5a.75.75 0 0 0-.75.75v5.25a.75.75 0 0 1-.75.75h-3a1.5 1.5 0 0 1-1.5-1.5v-6.13l-.22.22a.75.75 0 1 1-1.06-1.06l8.69-8.69Z"/>'.html_safe
    %>
    <%= render "layouts/nav_item", label: "Dashboard", path: dashboard_path, icon: home_svg, active: current_page?(dashboard_path) %>
  </nav>

  <% if Rails.env.development? %>
    <div class="border-t border-line p-3">
      <%= link_to guide_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-brand hover:bg-brand-soft" do %>
        <span aria-hidden="true">✦</span> Starter Guide
      <% end %>
    </div>
  <% end %>
</aside>

<%# Backdrop (mobile only), tap to close. %>
<div id="app-sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-ink/40 lg:hidden"></div>
