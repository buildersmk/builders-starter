<header class="border-b border-line bg-surface">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5">
    <%= link_to dashboard_path, class: "text-lg font-extrabold tracking-tight text-ink" do %>
      builders<span class="text-brand">.</span>starter
    <% end %>
    <div class="flex items-center gap-4">
      <% if Current.account %>
        <span class="hidden items-center gap-2 text-sm text-muted sm:flex">
          <%= Current.account.name %>
          <span class="badge"><%= Current.account.plan.titleize %></span>
        </span>
      <% end %>
      <%= link_to "Pricing", pricing_path, class: "text-sm font-medium text-muted hover:text-ink" %>
      <%= button_to "Sign out", session_path, method: :delete,
            class: "text-sm font-semibold text-muted hover:text-ink", form: { data: { turbo_confirm: "Sign out?" } } %>
    </div>
  </div>
</header>
