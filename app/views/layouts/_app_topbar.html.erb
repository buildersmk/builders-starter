<%# Top bar: menu button (mobile) + section title on the left; one account menu on the right.
    Everything about "you" — workspace, plan, billing, install, sign out — lives in that one menu. %>
<header class="sticky top-0 z-20 flex h-16 shrink-0 items-center gap-3 border-b border-line bg-surface/90 px-5 backdrop-blur sm:px-8">
  <button type="button" id="app-nav-open" class="-ml-1 rounded-lg p-2 text-muted hover:bg-slate-100 lg:hidden" aria-label="Open menu">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
  </button>

  <h1 class="truncate text-base font-bold text-ink"><%= content_for(:page_title).presence || "Dashboard" %></h1>

  <div class="relative ml-auto" data-controller="menu">
    <button type="button" data-action="menu#toggle"
            class="flex items-center gap-2 rounded-full py-1 pl-1 pr-2 text-sm hover:bg-slate-100" aria-label="Account menu">
      <% if Current.user&.name.present? %>
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-ink text-xs font-bold text-white">
          <%= Current.user.name.split.map(&:first).first(2).join.upcase %>
        </span>
      <% end %>
      <span class="hidden max-w-[10rem] truncate font-medium text-ink sm:block"><%= Current.account&.name %></span>
      <svg class="h-4 w-4 text-subtle" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.2 7.7a1 1 0 0 1 1.4 0L10 11.1l3.4-3.4a1 1 0 1 1 1.4 1.4l-4.1 4.1a1 1 0 0 1-1.4 0L5.2 9.1a1 1 0 0 1 0-1.4Z" clip-rule="evenodd"/></svg>
    </button>

    <div data-menu-target="panel" class="absolute right-0 mt-2 hidden w-64 origin-top-right rounded-xl border border-line bg-surface p-1.5 shadow-lg">
      <div class="px-3 py-2">
        <p class="truncate text-sm font-semibold text-ink"><%= Current.account&.name %></p>
        <p class="mt-0.5 text-xs text-muted">
          <%= Current.account&.plan&.titleize %> plan<%= " · #{Current.user.role}" if Current.user %>
        </p>
      </div>

      <hr class="my-1.5 border-line">

      <% if Current.account&.pro? %>
        <%= link_to "Manage billing", billing_portal_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-body hover:bg-slate-50" %>
      <% else %>
        <%= link_to "Upgrade to Pro", pricing_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-body hover:bg-slate-50" %>
      <% end %>

      <%# Appears only when the browser offers to install (install_controller reveals it). %>
      <button type="button" data-install-target="button" data-action="install#install"
              class="hidden w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-body hover:bg-slate-50">
        Install app
      </button>

      <hr class="my-1.5 border-line">

      <%= button_to "Sign out", session_path, method: :delete,
            class: "block w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-body hover:bg-slate-50",
            form: { data: { turbo_confirm: "Sign out?" } } %>
    </div>
  </div>
</header>
