<%# Classic top bar: menu button (mobile) + page title on the left; account + user on the right. %>
<header class="sticky top-0 z-20 flex h-16 shrink-0 items-center gap-3 border-b border-line bg-surface/90 px-5 backdrop-blur sm:px-8">
  <button type="button" id="app-nav-open" class="-ml-1 rounded-lg p-2 text-muted hover:bg-slate-100 lg:hidden" aria-label="Open menu">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
  </button>

  <h1 class="truncate text-base font-bold text-ink"><%= content_for(:page_title).presence || "Dashboard" %></h1>

  <div class="ml-auto flex items-center gap-3">
    <% if Current.account %>
      <span class="hidden items-center gap-2 text-sm text-muted sm:flex">
        <%= Current.account.name %>
        <span class="badge"><%= Current.account.plan.titleize %></span>
      </span>
    <% end %>
    <% if Current.user&.name.present? %>
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-ink text-xs font-bold text-white" title="<%= Current.user.name %>">
        <%= Current.user.name.split.map(&:first).first(2).join.upcase %>
      </span>
    <% end %>
    <%= button_to "Sign out", session_path, method: :delete,
          class: "text-sm font-semibold text-muted hover:text-ink", form: { data: { turbo_confirm: "Sign out?" } } %>
  </div>
</header>
