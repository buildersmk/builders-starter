<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8">
    <title>Offline</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= stylesheet_link_tag "tailwind" %>
  </head>
  <body class="flex min-h-full items-center justify-center bg-canvas font-sans text-body antialiased">
    <main class="mx-auto max-w-sm px-6 text-center">
      <span class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-soft text-2xl">⚡</span>
      <h1 class="text-2xl font-bold text-ink">You're offline</h1>
      <p class="mt-2 text-muted">No internet connection right now. Check your network and try again — your work is safe.</p>
      <button onclick="location.reload()" class="btn btn-primary mt-6">Try again</button>
    </main>
  </body>
</html>
